    {
      "parameters": {
        "jsCode": "// Picks the questions in #ask-copilot that haven't been answered yet.\n\nconst CHANNEL = 'C0CJQH2J059';   // #ask-copilot (the channel ID)\n\n// The bot remembers which messages it already answered (only when the workflow is published).\nconst memory = $getWorkflowStaticData('global');\nmemory.answered = Array.isArray(memory.answered) ? memory.answered : [];\n\nconst messages = $input.all()\n  .map((item) => item.json)\n  .filter((m) => m && m.ts)\n  .sort((a, b) => Number(a.ts) - Number(b.ts));   // oldest first\n\nconst questions = [];\nfor (const m of messages) {\n  if (m.bot_id || m.subtype) continue;              // bots (including this one) and \"X joined\" notices\n  if (memory.answered.includes(m.ts)) continue;     // already answered\n  memory.answered.push(m.ts);\n\n  // \"<@U0123ABC> who has GHL?\" → \"who has GHL?\"\n  const question = String(m.text || '')\n    .replace(/<@[A-Z0-9]+(\\|[^>]*)?>/g, ' ')\n    .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')\n    .replace(/\\s+/g, ' ')\n    .trim();\n  if (!question) continue;\n\n  questions.push({\n    json: {\n      question,              // what the recruiter asked\n      source: 'slack',\n      asked_by: m.user,      // Slack user ID of the recruiter\n      channel: CHANNEL,      // where to reply\n      thread_ts: m.ts,       // reply in the thread under their message\n    },\n  });\n}\nmemory.answered = memory.answered.slice(-200);\n\nreturn questions;"
      },
      "type": "n8n-nodes-base.code",
